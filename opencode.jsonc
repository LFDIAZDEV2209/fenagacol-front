{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    // MCPs remotos (OAuth). Supabase fijado al proyecto ffsgompvfrgmlksvyuqc.
    // Login: /mcps en la interfaz de OpenCode -> seleccionar servidor -> iniciar sesión.
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=ffsgompvfrgmlksvyuqc&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      }
    }
  },
  "permission": {
    "bash": {
      "yarn *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "opencode *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  }
}
